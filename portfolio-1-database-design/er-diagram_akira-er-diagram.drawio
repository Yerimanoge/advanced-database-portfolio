        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    USERS ||--o{ WALLETS : owns\n    USERS ||--o{ DEVICES : \&quot;logs in from\&quot;\n    WALLETS ||--o{ ADDRESSES : has\n    USERS ||--o| MERCHANTS : registers\n    WALLETS ||--o| MERCHANTS : \&quot;is merchant wallet of\&quot;\n    WALLETS ||--o{ TRANSACTIONS : \&quot;sends (sender)\&quot;\n    WALLETS ||--o{ TRANSACTIONS : \&quot;receives (recipient)\&quot;\n    TRANSACTIONS ||--o{ LEDGER_ENTRIES : \&quot;posts to\&quot;\n    WALLETS ||--o{ LEDGER_ENTRIES : \&quot;is affected by\&quot;\n\n    USERS {\n        int id PK\n        varchar username\n        varchar email UK\n        date created_at\n    }\n    DEVICES {\n        int id PK\n        int user_id FK\n        varchar device_type\n        datetime last_accessed\n    }\n    WALLETS {\n        int id PK\n        int user_id FK\n        enum wallet_type\n        decimal opening_balance\n        decimal balance\n        date created_at\n    }\n    ADDRESSES {\n        int id PK\n        int wallet_id FK\n        varchar address\n    }\n    MERCHANTS {\n        int id PK\n        int user_id FK, UK\n        int wallet_id FK, UK\n        varchar business_name UK\n        varchar category\n    }\n    TRANSACTIONS {\n        int id PK\n        int wallet_id FK \&quot;sender\&quot;\n        int to_wallet_id FK \&quot;recipient\&quot;\n        enum type\n        enum status\n        decimal amount\n        datetime timestamp\n    }\n    LEDGER_ENTRIES {\n        int id PK\n        int transaction_id FK\n        int wallet_id FK\n        enum entry_kind\n        decimal change_amount\n        decimal balance_after\n        timestamp created_at\n    }&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="yQHZSj0aWZYis1-PsZhu-1">
